# NiceEze 本番環境変数（プレースホルダー）
# 実際の値はGCP Secret Managerに登録し、Cloud Runにマウントすること
# ISMS: 本ファイルをGitにコミット可（値はプレースホルダーのみ）

# GCP設定
GCP_PROJECT_ID=serene-bonbon-236821

# Keepa API（Gate A — 松浦CEO要設定）
KEEPA_API_KEY=your-keepa-api-key-here

# Cloud Functions
CLOUD_FUNCTIONS_URL=https://asia-northeast1-your-project.cloudfunctions.net

# FinOps上限監視
FINOPS_MONTHLY_LIMIT_JPY=5000
FINOPS_PER_DELIVERY_LIMIT_JPY=0.5

# NiceEzeブランド
NICEEZE_ENV=production
NICEEZE_VERSION=1.0.0
